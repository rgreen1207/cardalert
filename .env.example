# Copy to .env and fill in ONLY the channel(s) you actually want. Everything
# here is optional — an unfilled section just means that channel stays off.
# Full step-by-step setup for each is in README.md > "Notification setup".

# --- Discord (always available, free) ---
DISCORD_WEBHOOK_URL=

# --- ntfy (free, no signup) ---
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Pushover (one-time ~$5 per platform, paid directly to Pushover) ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- SMS via Twilio (your own account; fractions of a cent/text + ~$1/mo) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Retailer API keys ---
# Free key from developer.bestbuy.com — only needed if you add Best Buy items
BESTBUY_API_KEY=

# --- License (pro tier) ---
GUMROAD_PRODUCT_ID=
CARDALERT_LICENSE_KEY=
